generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String   @unique
  password    String
  phoneNumber String   @unique
  adminRole   Boolean? 
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  category    String
  subCategory String?
  price       Float
  weight      Float
  description String?
  images      Json?     // store array of image URLs/base64
  sku         String    @unique
  stock       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

model Bill {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  billNo        String
  invoiceNo     String
  customerName  String
  customerPhone String
  customerEmail String?
  items         Json
  totalAmount   Float
  discount      Float
  gstPercent    Float      // total GST (3%)
  cgstPercent   Float?      // half GST 1.5%
  sgstPercent   Float?      // half GST 1.5%
  cgstAmount    Float?      // half GST amount
  sgstAmount    Float?      // half GST amount
  gstAmount     Float       // total GST amount
  netAmount     Float
  paymentStatus String      @default("pending")
  invoicePdfUrl String?
  created_at    DateTime    @default(now())
}


model Counter {
  id   String @id @map("_id")
  seq  Int
}




